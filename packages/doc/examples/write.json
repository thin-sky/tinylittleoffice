{
  "app": "write",
  "name": "Word Processor",
  "shapes": [
    {
      "id": "heading",
      "name": "headings",
      "for": "a text in sections: # and ## lines",
      "from": "template syllabus",
      "text": "## Policies\n\n*Late work.*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%23%23+Policies%0A%0A%2ALate+work.%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "h",
            "level": 2,
            "runs": [
              {
                "t": "Policies"
              }
            ]
          },
          {
            "k": "p",
            "runs": [
              {
                "t": "Late work.",
                "i": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "title",
      "name": "a title",
      "for": "the first line set large: # Words {.title}",
      "from": "template memo",
      "text": "# Memo {.title}\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%23+Memo+%7B.title%7D",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "h",
            "level": 1,
            "a": {
              "cls": [
                "title"
              ]
            },
            "runs": [
              {
                "t": "Memo"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "tasks",
      "name": "a task list",
      "for": "things to do and done: - [ ] and - [x]",
      "from": "template meeting",
      "text": "- [ ] *Who does what, by when*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=-+%5B+%5D+%2AWho+does+what%2C+by+when%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "done": false,
            "runs": [
              {
                "t": "Who does what, by when",
                "i": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "numbered",
      "name": "a numbered list",
      "for": "steps in order: 1. 2. 3.",
      "from": "template music-review",
      "text": "1. *Another*\n2. *A third*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=1.+%2AAnother%2A%0A2.+%2AA+third%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "ord": true,
            "runs": [
              {
                "t": "Another",
                "i": true
              }
            ]
          },
          {
            "k": "li",
            "depth": 0,
            "ord": true,
            "runs": [
              {
                "t": "A third",
                "i": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "bullets",
      "name": "a bulleted list",
      "for": "points in no order: - lines",
      "from": "template resume",
      "text": "- *What you did, with a number if you can*\n- *What you are good at*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=-+%2AWhat+you+did%2C+with+a+number+if+you+can%2A%0A-+%2AWhat+you+are+good+at%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "What you did, with a number if you can",
                "i": true
              }
            ]
          },
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "What you are good at",
                "i": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "align",
      "name": "an aligned paragraph",
      "for": "a line set right or centered: {.right} {.center}",
      "from": "template book-review",
      "text": "★★★★★ {.center}\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%E2%98%85%E2%98%85%E2%98%85%E2%98%85%E2%98%85+%7B.center%7D",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "p",
            "a": {
              "cls": [
                "center"
              ]
            },
            "runs": [
              {
                "t": "★★★★★"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "quote",
      "name": "a quotation",
      "for": "words set apart: > lines",
      "from": "template recipe",
      "text": "> *A note for next time.*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%3E+%2AA+note+for+next+time.%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "quote",
            "runs": [
              {
                "t": "A note for next time.",
                "i": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "footnote",
      "name": "a footnote",
      "for": "a note where its sentence is: ^[the note]",
      "from": "template petition",
      "text": "*The facts, and where they come from.*^[*The source.*]\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%2AThe+facts%2C+and+where+they+come+from.%2A%5E%5B%2AThe+source.%2A%5D",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "p",
            "runs": [
              {
                "t": "The facts, and where they come from.",
                "i": true
              },
              {
                "t": "",
                "fn": "*The source.*"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "marks",
      "name": "bold and highlights",
      "for": "words marked: **bold**, ==highlight==",
      "from": "template wedding",
      "text": "**To the couple.**\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%2A%2ATo+the+couple.%2A%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "p",
            "runs": [
              {
                "t": "To the couple.",
                "b": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "icon",
      "name": "an icon in a line",
      "for": "a picture among words: :icon-name:",
      "from": "template newsletter",
      "text": "## :coffee: Thank you\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%23%23+%3Acoffee%3A+Thank+you",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "h",
            "level": 2,
            "runs": [
              {
                "t": "",
                "ic": "coffee"
              },
              {
                "t": " Thank you"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "table",
      "name": "a table that adds up",
      "for": "an invoice’s lines, a price list: a money column and a total",
      "from": "template invoice",
      "text": "What | Qty:number | Units | Price:money | Amount:money\n--- | --- | --- | --- | ---\nDesign | 12 | hours | 150 | =B1*D1\nBuild | 20 | hours | 140 | =B2*D2\n",
      "link": "https://office.thin-sky.cloud/write/#doc=What+%7C+Qty%3Anumber+%7C+Units+%7C+Price%3Amoney+%7C+Amount%3Amoney%0A---+%7C+---+%7C+---+%7C+---+%7C+---%0ADesign+%7C+12+%7C+hours+%7C+150+%7C+%3DB1%2AD1%0ABuild+%7C+20+%7C+hours+%7C+140+%7C+%3DB2%2AD2",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "table",
            "cols": [
              {
                "name": "What",
                "type": "text"
              },
              {
                "name": "Qty",
                "type": "number"
              },
              {
                "name": "Units",
                "type": "text"
              },
              {
                "name": "Price",
                "type": "money"
              },
              {
                "name": "Amount",
                "type": "money"
              }
            ],
            "rows": [
              [
                "Design",
                "12",
                "hours",
                "150",
                "=B1*D1"
              ],
              [
                "Build",
                "20",
                "hours",
                "140",
                "=B2*D2"
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "look",
      "name": "a look",
      "for": "the page’s type and colors: look: in the head",
      "from": "template cover",
      "text": "---\nlook: mixed\n---\n*Your name*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=---%0Alook%3A+mixed%0A---%0A%2AYour+name%2A",
      "json": {
        "head": {
          "look": "mixed"
        },
        "blocks": [
          {
            "k": "p",
            "runs": [
              {
                "t": "Your name",
                "i": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "chart",
      "name": "a chart in a text",
      "for": "another document inside this one: a ```sheet fence",
      "from": "template news",
      "text": "```sheet\n---\ntitle: The figures\nchart: bar\n---\nMonth | On time:percent\n--- | ---\nMay | 71\nJun | 63\nJul | 52\nAug | 47\nSep | 55\n```\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%60%60%60sheet%0A---%0Atitle%3A+The+figures%0Achart%3A+bar%0A---%0AMonth+%7C+On+time%3Apercent%0A---+%7C+---%0AMay+%7C+71%0AJun+%7C+63%0AJul+%7C+52%0AAug+%7C+47%0ASep+%7C+55%0A%60%60%60",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "fence",
            "lang": "sheet",
            "body": "---\ntitle: The figures\nchart: bar\n---\nMonth | On time:percent\n--- | ---\nMay | 71\nJun | 63\nJul | 52\nAug | 47\nSep | 55"
          }
        ]
      }
    },
    {
      "id": "figure",
      "name": "a figure in the text",
      "for": "a drawing, a diagram, a chart or a map in a fence named by its app",
      "from": "template memo",
      "text": "```diagram\n---\ntitle: Who does what\nkind: lanes\n---\n- You: Write the change down\n- Readers: Do their part by the date\n- You: Check that it was done\n```\n\n*What each reader does, and by when.*\n",
      "link": "https://office.thin-sky.cloud/write/#doc=%60%60%60diagram%0A---%0Atitle%3A+Who+does+what%0Akind%3A+lanes%0A---%0A-+You%3A+Write+the+change+down%0A-+Readers%3A+Do+their+part+by+the+date%0A-+You%3A+Check+that+it+was+done%0A%60%60%60%0A%0A%2AWhat+each+reader+does%2C+and+by+when.%2A",
      "json": {
        "head": {},
        "blocks": [
          {
            "k": "fence",
            "lang": "diagram",
            "body": "---\ntitle: Who does what\nkind: lanes\n---\n- You: Write the change down\n- Readers: Do their part by the date\n- You: Check that it was done"
          },
          {
            "k": "p",
            "runs": [
              {
                "t": "What each reader does, and by when.",
                "i": true
              }
            ]
          }
        ]
      }
    }
  ]
}
