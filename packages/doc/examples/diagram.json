                "t": "2022: Everyone talks to a machine"
              }
            ]
          },
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "1969–2007: The network grows"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "venn",
      "name": "a Venn diagram",
      "for": "what two or three sets share: kind: venn, - Set: thing, - A & B: thing",
      "from": "template venn-skills",
      "text": "---\nkind: venn\n---\n- Writing: Esther\n- Code: Ravi, Tom\n- Design & Writing & Code: Bea\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+venn%0A---%0A-+Writing%3A+Esther%0A-+Code%3A+Ravi%2C+Tom%0A-+Design+%26+Writing+%26+Code%3A+Bea",
      "json": {
        "head": {
          "kind": "venn"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Writing: Esther"
              }
            ]
          },
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Code: Ravi, Tom"
              }
            ]
          },
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Design & Writing & Code: Bea"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "seating",
      "name": "a seating chart",
      "for": "who sits where: kind: seating, - Table: Ann, Bob",
