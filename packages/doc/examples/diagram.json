{
  "app": "diagram",
  "name": "Diagram Maker",
  "shapes": [
    {
      "id": "mind",
      "name": "a mind map",
      "for": "ideas branching from one: kind: mind, a nested list",
      "from": "template mind-garden",
      "text": "---\nkind: mind\n---\n- The garden\n  - Jobs\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+mind%0A---%0A-+The+garden%0A++-+Jobs",
      "json": {
        "head": {
          "kind": "mind"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "The garden"
              }
            ]
          },
          {
            "k": "li",
            "depth": 1,
            "runs": [
              {
                "t": "Jobs"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "org",
      "name": "an org chart",
      "for": "who reports to whom: kind: org, - Name | Role",
      "from": "template org-company",
      "text": "---\nkind: org\n---\n- Ada Diaz | Chief executive\n  - Eve Marsh | Design\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+org%0A---%0A-+Ada+Diaz+%7C+Chief+executive%0A++-+Eve+Marsh+%7C+Design",
      "json": {
        "head": {
          "kind": "org"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Ada Diaz | Chief executive"
              }
            ]
          },
          {
            "k": "li",
            "depth": 1,
            "runs": [
              {
                "t": "Eve Marsh | Design"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "family",
      "name": "a family tree",
      "for": "generations: kind: family, - Rose + Albert Hale | m. 1948",
      "from": "template family-hales",
      "text": "---\nkind: family\n---\n- Rose + Albert Hale | m. 1948\n  - David Hale | b. 1952\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+family%0A---%0A-+Rose+%2B+Albert+Hale+%7C+m.+1948%0A++-+David+Hale+%7C+b.+1952",
      "json": {
        "head": {
          "kind": "family"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Rose + Albert Hale | m. 1948"
              }
            ]
          },
          {
            "k": "li",
            "depth": 1,
            "runs": [
              {
                "t": "David Hale | b. 1952"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "lanes",
      "name": "swimlanes",
      "for": "a process passed between people: kind: lanes, - Who: what they do",
      "from": "template lanes-order",
      "text": "---\nkind: lanes\n---\n- Carrier: Delivers it\n- Customer: Signs for it\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+lanes%0A---%0A-+Carrier%3A+Delivers+it%0A-+Customer%3A+Signs+for+it",
      "json": {
        "head": {
          "kind": "lanes"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Carrier: Delivers it"
              }
            ]
          },
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Customer: Signs for it"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "timeline",
      "name": "a timeline",
      "for": "dates spaced as they fell: kind: timeline, - When: what happened",
      "from": "template timeline-computing",
      "text": "---\nkind: timeline\n---\n- 2022: Everyone talks to a machine\n- 1969–2007: The network grows\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+timeline%0A---%0A-+2022%3A+Everyone+talks+to+a+machine%0A-+1969%E2%80%932007%3A+The+network+grows",
      "json": {
        "head": {
          "kind": "timeline"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
