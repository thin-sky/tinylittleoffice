    {
      "id": "net",
      "name": "a network",
      "for": "what talks to what: kind: net, ~ A -> B: label",
      "from": "template net-webapp",
      "text": "---\nkind: net\n---\n- Monitoring\n\n~ API -- Worker: queue\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+net%0A---%0A-+Monitoring%0A%0A~+API+--+Worker%3A+queue",
      "json": {
        "head": {
          "kind": "net"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Monitoring"
              }
            ]
          },
          {
            "k": "edge",
            "from": "API",
            "to": "Worker",
            "dir": "--",
            "label": "queue"
          }
        ]
      }
    },
    {
      "id": "dotted",
      "name": "a dotted line",
      "for": "a tie outside the tree: ~ Ben -- Eve: advises",
      "from": "template mind-launch",
      "text": "---\nkind: mind\n---\n- Launch :rocket:\n  - Marketing\n    - A launch-day post\n  - Support\n    - Help pages\n\n~ A launch-day post -> Help pages: links to\n",
      "link": "https://office.thin-sky.cloud/diagram/#doc=---%0Akind%3A+mind%0A---%0A-+Launch+%3Arocket%3A%0A++-+Marketing%0A++++-+A+launch-day+post%0A++-+Support%0A++++-+Help+pages%0A%0A~+A+launch-day+post+-%3E+Help+pages%3A+links+to",
      "json": {
        "head": {
          "kind": "mind"
        },
        "blocks": [
          {
            "k": "li",
            "depth": 0,
            "runs": [
              {
                "t": "Launch "
              },
              {
                "t": "",
                "ic": "rocket"
              }
            ]
          },
          {
            "k": "li",
            "depth": 1,
            "runs": [
              {
                "t": "Marketing"
              }
            ]
          },
          {
            "k": "li",
            "depth": 2,
            "runs": [
              {
                "t": "A launch-day post"
              }
            ]
          },
          {
            "k": "li",
            "depth": 1,
            "runs": [
              {
                "t": "Support"
              }
            ]
          },
          {
            "k": "li",
            "depth": 2,
            "runs": [
              {
                "t": "Help pages"
              }
            ]
          },
          {
            "k": "edge",
            "from": "A launch-day post",
            "to": "Help pages",
            "dir": "->",
            "label": "links to"
          }
        ]
      }
    }
